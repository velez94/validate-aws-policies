{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {"Name": {"Type": "String", "Default": "reports"}},
  "Resources": {
    "Bucket": {"Type": "AWS::S3::Bucket"},
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "Bucket"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": {"Fn::Sub": "arn:aws:s3:::${Name}/*"}
            }
          ]
        }
      }
    },
    "Inline": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "inline",
        "Roles": ["role"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {"Effect": "Allow", "Action": ["s3:*", "ec2:*", "iam:*"], "Resource": "*"}
          ]
        }
      }
    }
  }
}
